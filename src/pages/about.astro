---
import Default from '../layouts/Default.astro';
const base = `${import.meta.env.BASE_URL}/`;
---

<Default pageTitle='About Me'>
	<main class="about-page">
		<section class="about-window">
			<div class="window-bar">■ ABOUT_ME.EXE <span>[ _ ][ □ ][ X ]</span></div>
			<div class="about-content">
				<p class="signal">[ TRANSMISSION FROM HRISHI ]</p>
				<h1>ABOUT ME</h1>
				<div class="about-orbit" aria-hidden="true">✦</div>
				<p class="manifesto">The connections are not always easy.</p>
				<p class="manifesto emphasis">Use lateral thinking and beware of Red Herrings.</p>
				<div class="about-note">
					<p>You know what NYT Connections is right?!</p>
					<p>This is like that with full rights reserved to me, and is related to Yake University, with all (re: most) word pairs having some Yale econnection.</p>
					<p>Of course, to create red herrings and make it a bit challenging, and given this is not my full-time job, I have to include non-Yale word pairs.</p>
					<p>Have fun, share it with friends, will add new games whenever I get any pockets of free time. Send in your submissions at <a href="mailto:hrishikesh.kayshap@yale.edu">hrishikesh.kayshap@yale.edu</a></p>
					<p>xoxo<br />Hrishi</p>
				</div>
				<a class="back-link" href={base}>← BACK TO CONNECTIONS</a>
			</div>
		</section>
	</main>
</Default>

<style>
	.about-page { width: min(920px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0; }
	.about-window { border: 4px solid #fff; background: #080808; box-shadow: 8px 8px 0 #777; }
	.window-bar { padding: .55rem .7rem; background: #222; color: #fff; letter-spacing: .08em; }
	.window-bar span { float: right; }
	.about-content { position: relative; overflow: hidden; padding: clamp(2rem, 7vw, 5rem); text-align: center; }
	.signal { animation: blink .9s steps(2) infinite; }
	.about-content h1 { font-family: var(--typewriter); font-size: clamp(2rem, 7vw, 4.5rem); letter-spacing: .12em; text-shadow: 5px 5px #7417b8; }
	.about-orbit { width: 120px; height: 120px; margin: 1.5rem auto; display: grid; place-items: center; border: 10px solid #ff2e91; outline: 7px solid #00d9ff; border-radius: 50%; background: repeating-conic-gradient(#ffeb00 0 45deg, #ff2e91 45deg 90deg, #00d9ff 90deg 135deg, #7dff34 135deg 180deg); color: #fff; font-size: 3rem; animation: spin 3s steps(8) infinite; }
	.manifesto { max-width: 650px; margin: 1rem auto; font-size: clamp(1.15rem, 3vw, 1.8rem); }
	.emphasis { color: #fff; text-shadow: 3px 3px #7417b8; }
	.about-note { max-width: 700px; margin: 2rem auto 0; text-align: left; line-height: 1.55; }
	.about-note p { margin: 1rem 0; }
	.about-note a { color: #00d9ff; }
	.back-link { display: inline-block; margin-top: 2rem; padding: .75rem 1rem; border: 3px solid #fff; color: #fff; text-decoration: none; }
	@keyframes blink { 50% { opacity: .25; } }
	@keyframes spin { to { transform: rotate(360deg); } }
</style>
