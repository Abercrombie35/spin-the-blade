---
const base = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<h2><a href={base}>TYN Connections</a></h2>
		<div class='internal-links'>
			<a href='#game-title'>PLAY</a>
			<span aria-hidden='true'>•</span>
			<a href={`${base}about/`}>ABOUT</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 3em;
		background: #333;
		border-bottom: 3px solid #fff;
	}
	h2 {
		margin: 0;
		font-size: 1.4em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
		nav a {
		padding: 1em 0.5em;
		color: whitesmoke;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		header { padding: 0 1em; }
	}
</style>
